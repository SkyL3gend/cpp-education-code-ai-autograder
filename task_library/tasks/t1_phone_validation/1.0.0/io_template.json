{
  "schema_version": "1.0",
  "template_id": "tpl_t1_phone_validation",
  "version": "1.0.0",
  "operation_id": "create_contact",
  "subject_level": "FUNCTION",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "initial_contacts",
      "candidate"
    ],
    "properties": {
      "initial_contacts": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/contact"
        }
      },
      "candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "phone",
          "birthday"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "birthday": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "month",
              "day"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "month": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31
              }
            }
          }
        }
      }
    },
    "$defs": {
      "contact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "phone",
          "birthday"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "birthday": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "month",
              "day"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "month": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31
              }
            }
          }
        }
      }
    }
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "created",
      "contacts_after"
    ],
    "properties": {
      "created": {
        "type": "boolean"
      },
      "contacts_after": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/contact"
        }
      }
    },
    "$defs": {
      "contact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "phone",
          "birthday"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "birthday": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  },
  "field_semantics": {
    "initial_contacts": "动作开始前通讯录中已有的联系人，按给定顺序写入。",
    "candidate": "本次尝试新增的联系人；phone 原样传入，不做预校验。",
    "created": "addContact 的返回值：是否成功创建。",
    "contacts_after": "动作执行后通讯录的完整投影，不得过滤或补全。"
  },
  "preconditions": [
    "通讯录可以先写入 initial_contacts",
    "动作只执行一次创建尝试"
  ],
  "steps": {
    "setup": [
      {
        "step_id": "seed_initial_contacts",
        "action": "seed_contacts"
      }
    ],
    "action": [
      {
        "step_id": "invoke_operation",
        "action": "create_contact"
      }
    ],
    "observe": [
      {
        "step_id": "read_created",
        "action": "read_json_field",
        "pointer": "/created"
      },
      {
        "step_id": "read_contacts_after",
        "action": "read_json_field",
        "pointer": "/contacts_after"
      }
    ],
    "teardown": []
  },
  "pre_operations": [],
  "required_observations": [
    "created",
    "contacts_after"
  ],
  "allowed_transforms": [
    "identity_v1"
  ],
  "encoding": "utf-8",
  "exit_contract": {
    "success_exit_codes": [
      0
    ],
    "observation_channel": "stdout_line"
  },
  "capability_requirements": {
    "needs_cpu_limit": true,
    "needs_memory_limit": true,
    "needs_wall_timeout": true,
    "needs_process_tree_kill": true,
    "needs_network_block": true
  }
}
