{
  "schema_version": "1.0",
  "task_spec": {
    "schema_version": "1.0",
    "task_id": "t1_phone_validation",
    "version": "1.0.0",
    "title": "T1 手机号校验：11 位数字且以 1 开头",
    "description": "简化通讯录的 addContact 在新增联系人前校验手机号。当前实现只检查长度与首位，无法识别后 10 位里的非数字字符。要求修正 isValidPhone，使 11 位非全数字的手机号被拒绝，且拒绝时通讯录不变。",
    "rules": [
      {
        "rule_id": "R1",
        "statement": "手机号必须恰好 11 个字符。"
      },
      {
        "rule_id": "R2",
        "statement": "手机号必须以 '1' 开头。"
      },
      {
        "rule_id": "R3",
        "statement": "手机号第 2—11 位必须全部是数字字符 '0'—'9'。"
      },
      {
        "rule_id": "R4",
        "statement": "手机号不合法时 addContact 必须返回 false，且通讯录内容保持不变。"
      }
    ],
    "case_ids": [
      "c_valid_11_ascii",
      "c_short_10",
      "c_long_12",
      "c_non_digit_11"
    ],
    "io_template_ref": {
