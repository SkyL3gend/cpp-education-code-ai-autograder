{
  "schema_version": "1.0",
  "task_spec": {
    "schema_version": "1.0",
    "task_id": "t2_birthday_today",
    "version": "1.0.0",
    "title": "T2 生日提醒：当天生日必须出现",
    "description": "生日提醒按“距离今天还有多少天”筛选。当前实现把“生日等于今天”误判为已经过去，从而把当天生日推到明年，导致当天生日的人收不到提醒。要求修正 daysUntilBirthday，使当天生日返回 0，已过的生日才算到明年。",
    "rules": [
      {
        "rule_id": "R1",
        "statement": "今天是联系人生日时，daysUntilBirthday 必须返回 0，该联系人必须出现在提醒列表中。"
      },
      {
        "rule_id": "R2",
        "statement": "生日尚未到达且距离不超过 days_ahead 的联系人必须出现在提醒列表中。"
      },
      {
        "rule_id": "R3",
        "statement": "生日已经过去的联系人必须按下一年的生日计算，不得出现在本次提醒中。"
      },
      {
        "rule_id": "R4",
        "statement": "days_ahead 为负数时提醒列表必须为空。"
      },
      {
        "rule_id": "R5",
        "statement": "生日提醒操作不得修改通讯录内容。"
      }
    ],
    "case_ids": [
      "c_today_exact",
      "c_today_window",
      "c_already_passed",
      "c_leap_day",
      "c_window_edge",
      "c_negative_window"
    ],
