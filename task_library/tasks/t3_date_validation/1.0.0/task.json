{
  "schema_version": "1.0",
  "task_spec": {
    "schema_version": "1.0",
    "task_id": "t3_date_validation",
    "version": "1.0.0",
    "title": "T3 生日日期校验：闰年与年份范围",
    "description": "新增联系人时校验生日是否为真实存在的日期。当前实现只限制月份和日下界，2 月一律允许 29 日，也不限制年份范围，因此 1900-02-29、1899-05-10 等非法日期会被接受。要求修正 isValidDate。",
    "rules": [
      {
        "rule_id": "R1",
        "statement": "年份必须在 1900—2100 之间（含端点）。"
      },
      {
        "rule_id": "R2",
        "statement": "月份必须在 1—12 之间。"
      },
      {
        "rule_id": "R3",
        "statement": "日期必须真实存在：2 月在闰年为 29 天、平年为 28 天，其它月份按实际天数。"
      },
      {
        "rule_id": "R4",
        "statement": "日期不合法时 addContact 必须返回 false，且通讯录内容保持不变。"
      }
    ],
    "case_ids": [
      "c_valid_leap",
      "c_valid_common",
      "c_invalid_1900_02_29",
      "c_invalid_year_low",
      "c_invalid_year_high",
      "c_invalid_april_31"
    ],
    "io_template_ref": {
      "id": "tpl_t3_date_validation",
