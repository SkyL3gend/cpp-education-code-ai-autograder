  "task_spec": {
    "schema_version": "1.0",
    "task_id": "t4_name_search",
    "version": "1.0.0",
    "title": "T4 姓名检索：不区分大小写并返回全部匹配",
    "description": "按姓名关键字检索联系人。当前实现区分大小写，且找到第一个匹配就 break，导致“返回全部匹配”和“大小写不敏感”两条要求都不满足。要求修正 searchByName。",
    "rules": [
      {
        "rule_id": "R1",
        "statement": "关键字按姓名子串匹配（包含即可，不要求前缀）。"
      },
      {
        "rule_id": "R2",
        "statement": "匹配不区分 ASCII 字母大小写。"
      },
      {
        "rule_id": "R3",
        "statement": "必须返回全部匹配的联系人，不能只返回第一个。"
      },
      {
        "rule_id": "R4",
        "statement": "关键字为空时返回空列表。"
      },
      {
        "rule_id": "R5",
        "statement": "姓名检索不得修改通讯录内容。"
      }
    ],
    "case_ids": [
      "c_case_insensitive",
      "c_chinese",
      "c_upper_keyword",
      "c_empty_keyword",
      "c_no_match"
    ],
