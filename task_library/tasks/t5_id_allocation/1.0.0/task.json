  "task_spec": {
    "schema_version": "1.0",
    "task_id": "t5_id_allocation",
    "version": "1.0.0",
    "title": "T5 编号分配：删除后新增不得重复",
    "description": "新增联系人时分配自增编号。当前实现用“当前条数 + 1”生成编号，删除中间编号后再新增就会产生重复编号。要求修正编号分配逻辑，保证编号大于现有最大编号且已有联系人的编号不变。",
    "rules": [
      {
        "rule_id": "R1",
        "statement": "新增联系人的编号必须大于当前所有联系人的编号。"
      },
      {
        "rule_id": "R2",
        "statement": "删除联系人后不得复用仍被占用的编号。"
      },
      {
        "rule_id": "R3",
        "statement": "连续新增多个联系人时编号必须严格递增且唯一。"
      },
      {
        "rule_id": "R4",
        "statement": "删除不存在的编号不改变通讯录。"
      },
      {
        "rule_id": "R5",
        "statement": "编号分配不得修改已有联系人的编号。"
      }
    ],
    "case_ids": [
      "c_delete_then_add",
      "c_empty_book",
      "c_max_seed",
      "c_delete_nonexistent",
      "c_multi_add"
    ],
